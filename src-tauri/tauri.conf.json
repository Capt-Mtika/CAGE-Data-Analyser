{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAGE Crop Intelligence",
  "version": "0.1.0",
  "identifier": "mw.cage.cropintelligence",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title":"CAGE Crop Intelligence","width":1480,"height":960,"minWidth":1100,"minHeight":700}],
    "security": {"csp": null}
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {"minimumSystemVersion":"13.0"}
  }
}
